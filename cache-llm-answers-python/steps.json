[
 {
  "id": "01-venv",
  "title": "Create a virtual environment",
  "kind": "run",
  "cmd": "python3 -m venv .venv && ls -d .venv",
  "show": "python3 -m venv .venv",
  "must_contain": [
   ".venv"
  ]
 },
 {
  "id": "02-install",
  "title": "Install the SDK",
  "kind": "run",
  "venv": true,
  "cmd": "pip install -q -r requirements.txt && pip show anthropic | sed -n 1,2p",
  "show": "pip install -r requirements.txt",
  "timeout": 300,
  "env": {
   "PIP_DISABLE_PIP_VERSION_CHECK": "1"
  },
  "must_contain": [
   "Name: anthropic"
  ]
 },
 {
  "id": "03-keys",
  "title": "See what goes into a cache key",
  "kind": "run",
  "venv": true,
  "cmd": "python key_demo.py",
  "must_contain": [
   "same request again",
   "other model name",
   "extra space inside"
  ]
 },
 {
  "id": "04-no-key",
  "title": "What a missing key looks like",
  "kind": "run",
  "venv": true,
  "cmd": "python ask_many.py questions.txt",
  "expect_exit": 1,
  "must_contain": [
   "ANTHROPIC_API_KEY is not set"
  ]
 },
 {
  "id": "05-first-run",
  "title": "First run: empty cache",
  "kind": "run",
  "venv": true,
  "needs_key": [
   "ANTHROPIC_API_KEY"
  ],
  "cmd": "rm -f cache*.json && python ask_many.py questions.txt",
  "show": "python ask_many.py questions.txt",
  "must_contain": [
   "API calls: 5",
   "cache hits: 2"
  ]
 },
 {
  "id": "06-second-run",
  "title": "Second run: full cache",
  "kind": "run",
  "venv": true,
  "needs_key": [
   "ANTHROPIC_API_KEY"
  ],
  "cmd": "python ask_many.py questions.txt",
  "must_contain": [
   "API calls: 0",
   "cache hits: 7"
  ]
 },
 {
  "id": "07-normalize",
  "title": "Tidy the question before hashing",
  "kind": "run",
  "venv": true,
  "needs_key": [
   "ANTHROPIC_API_KEY"
  ],
  "cmd": "python ask_many.py questions.txt --normalize --cache cache-normalized.json",
  "must_contain": [
   "API calls: 4",
   "cache hits: 3"
  ]
 },
 {
  "id": "08-settings",
  "title": "Change max_tokens and miss again",
  "kind": "run",
  "venv": true,
  "needs_key": [
   "ANTHROPIC_API_KEY"
  ],
  "cmd": "python ask_many.py questions.txt --limit 2 --max-tokens 500",
  "must_contain": [
   "API calls: 2",
   "cache hits: 0"
  ]
 },
 {
  "id": "08b-temperature",
  "title": "Try to send a temperature",
  "kind": "run",
  "venv": true,
  "needs_key": [
   "ANTHROPIC_API_KEY"
  ],
  "cmd": "python temperature_probe.py",
  "must_contain": [
   "HTTP 400",
   "temperature"
  ]
 },
 {
  "id": "09-expiry",
  "title": "Let an entry expire",
  "kind": "run",
  "venv": true,
  "needs_key": [
   "ANTHROPIC_API_KEY"
  ],
  "cmd": "rm -f cache-expiry.json && python expiry_demo.py",
  "show": "python expiry_demo.py",
  "must_contain": [
   "first ask       MISS",
   "right away      HIT",
   "after 3 s wait  MISS"
  ]
 },
 {
  "id": "10-empty",
  "title": "Check that an empty reply is never cached",
  "kind": "run",
  "venv": true,
  "cmd": "python test_cache.py",
  "must_contain": [
   "empty reply: not cached",
   "all checks passed"
  ]
 }
]