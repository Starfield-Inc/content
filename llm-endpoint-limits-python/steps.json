[
 {"id": "01-venv", "title": "Create a virtual environment", "kind": "run",
  "cmd": "python3 -m venv .venv && ls -d .venv", "show": "python3 -m venv .venv", "must_contain": [".venv"]},
 {"id": "02-install", "title": "Install the packages", "kind": "run", "venv": true,
  "cmd": "pip install -q -r requirements.txt && pip list 2>/dev/null | grep -iE '^(anthropic|fastapi|uvicorn|httpx) '",
  "show": "pip install -r requirements.txt", "timeout": 400,
  "env": {"PIP_DISABLE_PIP_VERSION_CHECK": "1"}, "must_contain": ["fastapi", "uvicorn"]},
 {"id": "03-unit", "title": "Check the two guards with fixed numbers", "kind": "run", "venv": true,
  "cmd": "python test_limits.py", "must_contain": ["all checks passed"]},
 {"id": "04-no-key", "title": "What a missing key looks like", "kind": "run", "venv": true,
  "cmd": "python -c 'import app'", "show": "python -c \"import app\"", "expect_exit": 1,
  "must_contain": ["ANTHROPIC_API_KEY is not set"]},
 {"id": "05-rate", "title": "Reject over the per-user limit", "kind": "run", "venv": true, "needs_key": ["ANTHROPIC_API_KEY"],
  "cmd": "python demo.py rate", "timeout": 180, "must_contain": ["HTTP 429 Retry-After:", "\"error\":\"rate limit\"", "[ben] HTTP 200"]},
 {"id": "06-cap", "title": "Stop at the daily cost cap", "kind": "run", "venv": true, "needs_key": ["ANTHROPIC_API_KEY"],
  "cmd": "python demo.py cap", "timeout": 180, "must_contain": ["daily cost cap reached", "usage:"]},
 {"id": "07-logs", "title": "Read the blocked-call log", "kind": "run", "venv": true,
  "cmd": "python demo.py logs", "must_contain": ["rate limit", "daily cost cap reached"]},
 {"id": "08-restart", "title": "See a restart wipe the counters", "kind": "run", "venv": true, "needs_key": ["ANTHROPIC_API_KEY"],
  "cmd": "python demo.py restart", "timeout": 180, "must_contain": ["after restart:", "\"calls\":0"]},
 {"id": "09-serve", "title": "Run the server and open the usage page", "kind": "web", "venv": true, "needs_key": ["ANTHROPIC_API_KEY"],
  "serve": "python -m uvicorn app:app --port 8136", "url": "http://127.0.0.1:8136/usage", "ready_timeout": 30,
  "size": [900, 300], "must_contain": ["cap_usd"]}
]
