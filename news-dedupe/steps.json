[
 {
  "id": "01-venv",
  "title": "Create a virtual environment",
  "kind": "run",
  "cmd": "python3 -m venv .venv && ls -d .venv",
  "show": "python3 -m venv .venv",
  "must_contain": [
   ".venv"
  ]
 },
 {
  "id": "02-install",
  "title": "Install feedparser",
  "kind": "run",
  "venv": true,
  "cmd": "pip install -q -r requirements.txt && pip show feedparser | sed -n 1,2p",
  "show": "pip install -r requirements.txt",
  "must_contain": [
   "Name: feedparser"
  ],
  "timeout": 300,
  "env": {
   "PIP_DISABLE_PIP_VERSION_CHECK": "1"
  }
 },
 {
  "id": "03-fetch",
  "title": "Read the feeds",
  "kind": "run",
  "venv": true,
  "cmd": "python fetch_feeds.py",
  "must_contain": [
   "Saved",
   "items to items.json"
  ],
  "timeout": 180
 },
 {
  "id": "04-group",
  "title": "Group the repeated stories",
  "kind": "run",
  "venv": true,
  "cmd": "python dedupe.py",
  "must_contain": [
   "became",
   "stories"
  ]
 },
 {
  "id": "05-test",
  "title": "Check the rule on fixed headlines",
  "kind": "run",
  "venv": true,
  "cmd": "python -m unittest discover -s tests -v",
  "must_contain": [
   "OK",
   "test_different_version_numbers_stay_apart"
  ]
 },
 {
  "id": "06-page",
  "title": "Open the page",
  "kind": "web",
  "venv": true,
  "serve": "python app.py",
  "url": "http://127.0.0.1:8011/",
  "size": [
   1000,
   820
  ],
  "must_contain": [
   "News without the repeats",
   "Same story in"
  ]
 }
]