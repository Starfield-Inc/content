[
 {
  "id": "01-venv",
  "title": "Create a virtual environment",
  "kind": "run",
  "cmd": "python3 -m venv .venv && ls -d .venv",
  "show": "python3 -m venv .venv",
  "must_contain": [
   ".venv"
  ]
 },
 {
  "id": "02-install",
  "title": "Install the Anthropic SDK",
  "kind": "run",
  "venv": true,
  "cmd": "pip install -q -r requirements.txt && pip show anthropic | sed -n 1,2p",
  "show": "pip install -r requirements.txt",
  "must_contain": [
   "Name: anthropic"
  ],
  "timeout": 300,
  "env": {
   "PIP_DISABLE_PIP_VERSION_CHECK": "1"
  }
 },
 {
  "id": "03-ask",
  "title": "Send one prompt and read the answer",
  "kind": "run",
  "venv": true,
  "needs_key": [
   "ANTHROPIC_API_KEY"
  ],
  "cmd": "python ask.py capital",
  "must_contain": [
   "Prompt:",
   "Answer:"
  ]
 },
 {
  "id": "04-pass",
  "title": "Run the five prompt tests",
  "kind": "run",
  "venv": true,
  "needs_key": [
   "ANTHROPIC_API_KEY"
  ],
  "cmd": "python -m unittest -v test_prompts",
  "must_contain": [
   "Ran 5 tests"
  ],
  "timeout": 300
 },
 {
  "id": "05-diff",
  "title": "See the one prompt that changes",
  "kind": "run",
  "venv": true,
  "cmd": "diff prompts.py prompts_changed.py; true",
  "show": "diff prompts.py prompts_changed.py",
  "must_contain": [
   "summary"
  ]
 },
 {
  "id": "06-fail",
  "title": "Run the tests with the changed prompt",
  "kind": "run",
  "venv": true,
  "needs_key": [
   "ANTHROPIC_API_KEY"
  ],
  "cmd": "set -o pipefail; PROMPTS_MODULE=prompts_changed python -m unittest -v test_prompts 2>&1 | sed \"s#$PWD/##\"",
  "expect_exit": 1,
  "must_contain": [
   "Ran 5 tests",
   "FAILED"
  ],
  "timeout": 300,
  "show": "PROMPTS_MODULE=prompts_changed python -m unittest -v test_prompts"
 },
 {
  "id": "07-no-key",
  "title": "What a missing key looks like",
  "kind": "run",
  "venv": true,
  "expect_exit": 2,
  "cmd": "python -m unittest test_prompts",
  "must_contain": [
   "ANTHROPIC_API_KEY is not set"
  ]
 },
 {
  "id": "08-spend",
  "title": "Add up the spend log",
  "kind": "run",
  "venv": true,
  "cmd": "python spend.py",
  "must_contain": [
   "Calls:",
   "Estimated cost"
  ]
 }
]