[
 {"id": "01-venv", "title": "Create a virtual environment", "kind": "run",
  "cmd": "python3 -m venv .venv && ls -d .venv", "show": "python3 -m venv .venv", "must_contain": [".venv"]},
 {"id": "02-install", "title": "Install the SDK", "kind": "run", "venv": true,
  "cmd": "pip install -q -r requirements.txt && pip show anthropic | sed -n 1,2p",
  "show": "pip install -r requirements.txt", "timeout": 300,
  "env": {"PIP_DISABLE_PIP_VERSION_CHECK": "1"}, "must_contain": ["Name: anthropic"]},
 {"id": "03-extract", "title": "List the numbers in the source", "kind": "run", "venv": true,
  "cmd": "python numcheck.py report.txt", "must_contain": ["distinct numbers in report.txt", "1284500"]},
 {"id": "04-compare-fixed", "title": "Compare the source with a hand-written summary", "kind": "run", "venv": true,
  "cmd": "python numcheck.py report.txt bad_summary.txt",
  "must_contain": ["Missing from summary:", "In summary but not in source: 1", "7900"]},
 {"id": "05-split", "title": "Split the report into chunks", "kind": "run", "venv": true,
  "cmd": "python chunks.py report.txt", "must_contain": ["chunks (max 900 characters)", "chunk 1:"]},
 {"id": "06-no-key", "title": "What a missing key looks like", "kind": "run", "venv": true,
  "cmd": "python summarize.py report.txt", "expect_exit": 1,
  "must_contain": ["ANTHROPIC_API_KEY is not set"]},
 {"id": "07-summarize", "title": "Summarise by chunks, merge, check the numbers", "kind": "run", "venv": true,
  "needs_key": ["ANTHROPIC_API_KEY"], "cmd": "python summarize.py report.txt",
  "must_contain": ["Summary (", "Source numbers: 72", "Missing from summary:", "[tokens used:"]},
 {"id": "08-short", "title": "Ask for a shorter summary", "kind": "run", "venv": true,
  "needs_key": ["ANTHROPIC_API_KEY"], "cmd": "python summarize.py report.txt --words 50",
  "must_contain": ["Summary (", "Source numbers: 72", "Missing from summary:"]},
 {"id": "09-missing-file", "title": "What a wrong file name looks like", "kind": "run", "venv": true,
  "cmd": "python numcheck.py notes.txt", "expect_exit": 1, "must_contain": ["Cannot find notes.txt"]}
]
