[
 {"id": "01-venv", "title": "Create a virtual environment", "kind": "run",
  "cmd": "python3 -m venv .venv && ls -d .venv", "show": "python3 -m venv .venv", "must_contain": [".venv"]},
 {"id": "02-install", "title": "Install feedparser and the SDK", "kind": "run", "venv": true,
  "cmd": "pip install -q -r requirements.txt && pip show feedparser anthropic | grep -E '^(Name|Version)'",
  "show": "pip install -r requirements.txt", "timeout": 300,
  "env": {"PIP_DISABLE_PIP_VERSION_CHECK": "1"}, "must_contain": ["Name: feedparser", "Name: anthropic"]},
 {"id": "03-fetch", "title": "Read the five feeds", "kind": "run", "venv": true,
  "cmd": "python fetch_feeds.py --out live/items.json", "timeout": 120,
  "must_contain": ["Saved 15 items to live/items.json"]},
 {"id": "04-dedupe", "title": "Remove duplicates from fixed example items", "kind": "run", "venv": true,
  "cmd": "python dedupe.py sample_items.json unique.json",
  "must_contain": ["6 items in, 5 kept, 1 duplicates removed"]},
 {"id": "05-no-key", "title": "What a missing key looks like", "kind": "run", "venv": true,
  "cmd": "python summarise.py unique.json summaries.json", "expect_exit": 1,
  "must_contain": ["ANTHROPIC_API_KEY is not set"]},
 {"id": "06-summarise", "title": "Summarise each item", "kind": "run", "venv": true, "needs_key": ["ANTHROPIC_API_KEY"],
  "cmd": "python summarise.py unique.json summaries.json --limit 5", "timeout": 180,
  "must_contain": ["Not enough text to summarise.", "Summarised 5 items with claude-haiku-5-5"]},
 {"id": "07-page", "title": "Write the digest page", "kind": "run", "venv": true,
  "cmd": "python build_page.py summaries.json --when \"9 November 2026\" && head -n 5 digest.md",
  "must_contain": ["Wrote digest.html and digest.md with 5 items", "Source: Example Wire"]},
 {"id": "08-view", "title": "Open the digest page", "kind": "web", "venv": true,
  "serve": "python -m http.server 8019 --bind 127.0.0.1", "url": "http://127.0.0.1:8019/digest.html",
  "size": [900, 820], "must_contain": ["read the original"]},
 {"id": "09-live", "title": "Run the whole chain on the live feeds", "kind": "run", "venv": true, "needs_key": ["ANTHROPIC_API_KEY"],
  "cmd": "python dedupe.py live/items.json live/unique.json --quiet && python summarise.py live/unique.json live/summaries.json --limit 3 --quiet && python build_page.py live/summaries.json --html live/digest.html --md live/digest.md",
  "timeout": 240, "must_contain": ["Summarised 3 items", "Wrote live/digest.html and live/digest.md with 3 items"]}
]
