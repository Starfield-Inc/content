[
 {"id": "01-venv", "title": "Create a virtual environment", "kind": "run",
  "cmd": "python3 -m venv .venv && ls -d .venv", "show": "python3 -m venv .venv", "must_contain": [".venv"]},
 {"id": "02-install", "title": "Install the package", "kind": "run", "venv": true,
  "cmd": "pip install -q -r requirements.txt && pip list 2>/dev/null | grep -iE '^anthropic '",
  "show": "pip install -r requirements.txt", "timeout": 300,
  "env": {"PIP_DISABLE_PIP_VERSION_CHECK": "1"}, "must_contain": ["anthropic"]},
 {"id": "03-no-key", "title": "What a missing key looks like", "kind": "run", "venv": true,
  "cmd": "python one_call.py", "expect_exit": 1, "must_contain": ["ANTHROPIC_API_KEY is not set"]},
 {"id": "04-one-call", "title": "Make one real call and save the answer", "kind": "run", "venv": true, "needs_key": ["ANTHROPIC_API_KEY"],
  "cmd": "python one_call.py", "must_contain": ["reply:", "input tokens:", "output tokens:", "saved saved_answer.json"]},
 {"id": "05-sdk-source", "title": "Read the SDK retry rules from the installed package", "kind": "run", "venv": true,
  "cmd": "python show_sdk_retry.py", "must_contain": ["DEFAULT_MAX_RETRIES = 2", "429"]},
 {"id": "06-reproduce", "title": "Reproduce a 429 and an overloaded error", "kind": "run", "venv": true,
  "timeout": 120, "cmd": "python reproduce.py", "must_contain": ["RateLimitError", "OverloadedError", "retry-after"]},
 {"id": "07-wrapper", "title": "Retry with backoff, then fall back", "kind": "run", "venv": true,
  "timeout": 120, "cmd": "python demo_wrapper.py", "must_contain": ["retry 1 of", "source: saved"]},
 {"id": "08-layers", "title": "Two retry layers multiply", "kind": "run", "venv": true,
  "timeout": 120, "cmd": "python layers.py", "must_contain": ["calls that reached the stand-in"]},
 {"id": "09-tests", "title": "Run the unit tests", "kind": "run", "venv": true,
  "timeout": 120, "cmd": "python -m unittest -v test_resilient", "must_contain": ["Ran ", "OK"]}
]
