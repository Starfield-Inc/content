[
 {"id": "01-venv", "title": "Create a virtual environment", "kind": "run",
  "cmd": "python3 -m venv .venv && ls -d .venv", "show": "python3 -m venv .venv", "must_contain": [".venv"]},
 {"id": "02-install", "title": "Install the SDK", "kind": "run", "venv": true,
  "cmd": "pip install -q -r requirements.txt && pip show anthropic | sed -n 1,2p",
  "show": "pip install -r requirements.txt", "timeout": 300,
  "env": {"PIP_DISABLE_PIP_VERSION_CHECK": "1"}, "must_contain": ["Name: anthropic"]},
 {"id": "03-no-key", "title": "What a missing key looks like", "kind": "run", "venv": true,
  "cmd": "python chat.py < script.txt", "expect_exit": 1,
  "must_contain": ["ANTHROPIC_API_KEY is not set"]},
 {"id": "04-forgetful", "title": "Two calls with no memory", "kind": "run", "venv": true, "needs_key": ["ANTHROPIC_API_KEY"],
  "cmd": "python forgetful.py", "must_contain": ["you> My name is Maya.", "you> What is my name?"]},
 {"id": "05-memory", "title": "Keep the message list", "kind": "run", "venv": true, "needs_key": ["ANTHROPIC_API_KEY"],
  "cmd": "python chat.py < script.txt", "must_contain": ["[sent 7 messages: U A U A U A U", "[session total: input tokens"]},
 {"id": "06-trim", "title": "Trim old messages", "kind": "run", "venv": true, "needs_key": ["ANTHROPIC_API_KEY"],
  "cmd": "python chat.py --keep 4 < script.txt", "must_contain": ["[trimmed 2 old messages]", "[session total: input tokens"]}
]
