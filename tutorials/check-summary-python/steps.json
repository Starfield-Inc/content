[
 {"id": "01-venv", "title": "Create a virtual environment", "kind": "run",
  "cmd": "python3 -m venv .venv && ls -d .venv", "show": "python3 -m venv .venv", "must_contain": [".venv"]},
 {"id": "02-install", "title": "Install the SDK", "kind": "run", "venv": true,
  "cmd": "pip install -q -r requirements.txt && pip show anthropic | sed -n 1,2p",
  "show": "pip install -r requirements.txt", "timeout": 300,
  "env": {"PIP_DISABLE_PIP_VERSION_CHECK": "1"}, "must_contain": ["Name: anthropic"]},
 {"id": "03-no-key", "title": "What a missing key looks like", "kind": "run", "venv": true,
  "cmd": "python check_summary.py source.txt summary_good.txt", "expect_exit": 1,
  "must_contain": ["ANTHROPIC_API_KEY is not set"]},
 {"id": "04-good", "title": "Check a good summary", "kind": "run", "venv": true, "needs_key": ["ANTHROPIC_API_KEY"],
  "cmd": "python check_summary.py source.txt summary_good.txt", "timeout": 240,
  "must_contain": ["Claims listed:", "Report:"]},
 {"id": "05-bad", "title": "Check a summary with planted errors", "kind": "run", "venv": true, "needs_key": ["ANTHROPIC_API_KEY"],
  "cmd": "python check_summary.py source.txt summary_bad.txt", "timeout": 240,
  "must_contain": ["Claims listed:", "Report:", "NOT FOUND"]},
 {"id": "06-limits", "title": "Test the code-side checks with fixed data", "kind": "run", "venv": true,
  "cmd": "python test_judge.py", "must_contain": ["known miss"]}
]
