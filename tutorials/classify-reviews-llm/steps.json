[
 {"id": "01-venv", "title": "Create a virtual environment", "kind": "run",
  "cmd": "python3 -m venv .venv && ls -d .venv", "show": "python3 -m venv .venv", "must_contain": [".venv"]},
 {"id": "02-install", "title": "Install the Anthropic SDK", "kind": "run", "venv": true,
  "cmd": "pip install -q -r requirements.txt && pip show anthropic | sed -n 1,2p", "show": "pip install -r requirements.txt",
  "must_contain": ["Name: anthropic"], "timeout": 300, "env": {"PIP_DISABLE_PIP_VERSION_CHECK": "1"}},
 {"id": "03-data", "title": "Check the labelled reviews", "kind": "run", "venv": true,
  "cmd": "python check_data.py", "must_contain": ["Reviews: 50", "positive", "negative", "mixed"]},
 {"id": "04-one", "title": "Classify one review", "kind": "run", "venv": true, "needs_key": ["ANTHROPIC_API_KEY"],
  "cmd": "python classify.py --text \"The kettle boils fast but the lid broke in a month.\"",
  "must_contain": ["Predicted:"]},
 {"id": "05-run-v1", "title": "Run all 50 reviews with prompt v1", "kind": "run", "venv": true, "needs_key": ["ANTHROPIC_API_KEY"],
  "cmd": "python classify.py --prompt v1", "show": "python classify.py --prompt v1", "must_contain": ["Saved results_v1.csv"], "timeout": 600},
 {"id": "06-score-v1", "title": "Count right and wrong for v1", "kind": "run", "venv": true,
  "cmd": "python score.py results_v1.csv", "must_contain": ["Right:", "Wrong:"]},
 {"id": "07-run-v2", "title": "Change the prompt and rerun", "kind": "run", "venv": true, "needs_key": ["ANTHROPIC_API_KEY"],
  "cmd": "python classify.py --prompt v2", "must_contain": ["Saved results_v2.csv"], "timeout": 600},
 {"id": "08-score-v2", "title": "Compare v1 and v2", "kind": "run", "venv": true,
  "cmd": "python score.py results_v1.csv results_v2.csv", "must_contain": ["Right:", "Changed between runs"]},
 {"id": "09-no-key", "title": "What a missing key looks like", "kind": "run", "venv": true, "expect_exit": 2,
  "cmd": "python classify.py --text \"Works fine.\"", "must_contain": ["ANTHROPIC_API_KEY is not set"]},
 {"id": "10-spend", "title": "Add up the spend log", "kind": "run", "venv": true,
  "cmd": "python spend.py", "must_contain": ["Calls:", "Estimated cost"]}
]
