[
 {
  "id": "01-venv",
  "title": "Create a virtual environment",
  "kind": "run",
  "cmd": "python3 -m venv .venv && ls -d .venv",
  "show": "python3 -m venv .venv",
  "must_contain": [
   ".venv"
  ]
 },
 {
  "id": "02-install",
  "title": "Install tiktoken",
  "kind": "run",
  "venv": true,
  "cmd": "pip install -q -r requirements.txt && pip show tiktoken | sed -n 1,2p",
  "show": "pip install -r requirements.txt",
  "must_contain": [
   "Name: tiktoken"
  ],
  "timeout": 300,
  "env": {
   "PIP_DISABLE_PIP_VERSION_CHECK": "1"
  }
 },
 {
  "id": "03-split",
  "title": "See one sentence split into tokens",
  "kind": "run",
  "venv": true,
  "cmd": "python tokens_demo.py \"Tokens are not the same as words.\"",
  "must_contain": [
   "Tokens: 8"
  ]
 },
 {
  "id": "04-count",
  "title": "Count the tokens in a file",
  "kind": "run",
  "venv": true,
  "cmd": "python count_tokens.py sample.txt",
  "must_contain": [
   "cl100k_base",
   "o200k_base"
  ]
 },
 {
  "id": "05-cost",
  "title": "Turn the count into a cost estimate",
  "kind": "run",
  "venv": true,
  "cmd": "python count_tokens.py sample.txt --price-per-million 3.00",
  "must_contain": [
   "Cost"
  ]
 },
 {
  "id": "05b-languages",
  "title": "Count a text in two languages",
  "kind": "run",
  "venv": true,
  "cmd": "python count_tokens.py multilingual.txt",
  "must_contain": [
   "cl100k_base",
   "o200k_base"
  ]
 },
 {
  "id": "06-missing",
  "title": "What a wrong file name looks like",
  "kind": "run",
  "venv": true,
  "cmd": "python count_tokens.py notes.txt",
  "expect_exit": 2,
  "must_contain": [
   "Cannot find notes.txt"
  ]
 }
]