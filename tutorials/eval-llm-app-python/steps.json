[
 {"id": "01-venv", "title": "Create a virtual environment", "kind": "run",
  "cmd": "python3 -m venv .venv && ls -d .venv", "show": "python3 -m venv .venv", "must_contain": [".venv"]},
 {"id": "02-install", "title": "Install the SDK", "kind": "run", "venv": true,
  "cmd": "pip install -q -r requirements.txt && pip show anthropic | sed -n 1,2p",
  "show": "pip install -r requirements.txt", "timeout": 300,
  "env": {"PIP_DISABLE_PIP_VERSION_CHECK": "1"}, "must_contain": ["Name: anthropic"]},
 {"id": "03-no-key", "title": "What a missing key looks like", "kind": "run", "venv": true,
  "cmd": "python run_eval.py --only ship-time", "expect_exit": 1,
  "must_contain": ["ANTHROPIC_API_KEY is not set"]},
 {"id": "04-one-reply", "title": "Call the app once", "kind": "run", "venv": true, "needs_key": ["ANTHROPIC_API_KEY"],
  "cmd": "python app.py \"How long does shipping take?\"", "must_contain": ["business days"]},
 {"id": "05-test-checker", "title": "Test the checker with fixed replies", "kind": "run", "venv": true,
  "cmd": "python -m unittest -v test_checks 2>&1", "must_contain": ["Ran 5 tests", "OK"]},
 {"id": "06-eval-v1", "title": "Run the 20 cases against prompt v1", "kind": "run", "venv": true, "needs_key": ["ANTHROPIC_API_KEY"],
  "cmd": "python run_eval.py --prompt v1 --out results/v1.json", "timeout": 400,
  "must_contain": ["pass rate"]},
 {"id": "07-failures", "title": "Read the failing cases", "kind": "run", "venv": true,
  "cmd": "python show_failures.py results/v1.json", "must_contain": ["Case:", "Why it failed"]},
 {"id": "08-eval-v2-a", "title": "Run the cases against prompt v2", "kind": "run", "venv": true, "needs_key": ["ANTHROPIC_API_KEY"],
  "cmd": "python run_eval.py --prompt v2 --out results/v2-a.json", "timeout": 400,
  "must_contain": ["prompt v2", "pass rate"]},
 {"id": "09-eval-v2-b", "title": "Run the same prompt again", "kind": "run", "venv": true, "needs_key": ["ANTHROPIC_API_KEY"],
  "cmd": "python run_eval.py --prompt v2 --out results/v2-b.json", "timeout": 400,
  "must_contain": ["prompt v2", "pass rate"]},
 {"id": "10-compare", "title": "Compare the two runs", "kind": "run", "venv": true,
  "cmd": "python compare_runs.py results/v2-a.json results/v2-b.json", "must_contain": ["identical replies"]},
 {"id": "11-gate", "title": "Fail the run when the pass rate drops", "kind": "run", "venv": true, "needs_key": ["ANTHROPIC_API_KEY"],
  "cmd": "python run_eval.py --prompt v2 --only english-only --fail-under 100 ; echo \"exit code: $?\"",
  "show": "python run_eval.py --prompt v2 --only english-only --fail-under 100; echo \"exit code: $?\"",
  "must_contain": ["exit code: 1"]}
]
