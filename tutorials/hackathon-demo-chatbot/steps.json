[
 {"id": "01-venv", "title": "Create a virtual environment", "kind": "run",
  "cmd": "python3 -m venv .venv && ls -d .venv", "show": "python3 -m venv .venv", "must_contain": [".venv"]},
 {"id": "02-install", "title": "Install the packages", "kind": "run", "venv": true,
  "cmd": "pip install -q -r requirements.txt && pip list 2>/dev/null | grep -iE '^(anthropic|fastapi|uvicorn) '",
  "show": "pip install -r requirements.txt", "timeout": 300,
  "env": {"PIP_DISABLE_PIP_VERSION_CHECK": "1"}, "must_contain": ["anthropic", "fastapi", "uvicorn"]},
 {"id": "03-no-key", "title": "What a missing key looks like", "kind": "run", "venv": true,
  "cmd": "python one_call.py", "expect_exit": 1, "must_contain": ["ANTHROPIC_API_KEY is not set"]},
 {"id": "04-one-call", "title": "Make one call", "kind": "run", "venv": true, "needs_key": ["ANTHROPIC_API_KEY"],
  "cmd": "python one_call.py", "must_contain": ["reply:", "input tokens:", "output tokens:"]},
 {"id": "05-five-questions", "title": "Test the web API with five questions", "kind": "run", "venv": true,
  "needs_key": ["ANTHROPIC_API_KEY"], "timeout": 180,
  "cmd": "uvicorn app:app --port 8031 --log-level warning & SERVER=$!; python test_questions.py; STATUS=$?; kill $SERVER; exit $STATUS",
  "show": "python test_questions.py", "must_contain": ["5 of 5 questions answered"]},
 {"id": "06-page", "title": "Open the page", "kind": "web", "venv": true, "needs_key": ["ANTHROPIC_API_KEY"],
  "serve": "uvicorn app:app --port 8031 --log-level warning",
  "url": "http://127.0.0.1:8031/?ask=What%20is%20a%20REST%20API%3F%20Keep%20it%20to%20one%20sentence.",
  "size": [900, 560], "must_contain": ["What is a REST API?", "Hackathon demo chatbot"]}
]
