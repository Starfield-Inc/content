[
 {"id": "01-venv", "title": "Create a virtual environment", "kind": "run",
  "cmd": "python3 -m venv .venv && ls -d .venv", "show": "python3 -m venv .venv", "must_contain": [".venv"]},
 {"id": "02-install", "title": "Install the SDK", "kind": "run", "venv": true,
  "cmd": "pip install -q -r requirements.txt && pip show anthropic | sed -n 1,2p",
  "show": "pip install -r requirements.txt", "timeout": 300,
  "env": {"PIP_DISABLE_PIP_VERSION_CHECK": "1"}, "must_contain": ["Name: anthropic"]},
 {"id": "03-demo", "title": "Run the project once to get a demo screenshot", "kind": "run", "venv": true,
  "cmd": "cd sample-repo && python demo.py notes.txt", "show": "python demo.py notes.txt",
  "must_contain": ["Maya: update the roadmap page", "Tomas: fix the failing login test"]},
 {"id": "04-parts", "title": "Pull the parts out of the README", "kind": "run", "venv": true,
  "cmd": "python readme_parts.py sample-repo",
  "must_contain": ["Problem", "Flow boxes: 4"]},
 {"id": "05-missing", "title": "What a README with no Team section looks like", "kind": "run", "venv": true,
  "cmd": "mkdir -p thin-repo && printf '# Thin\\n\\n## Problem\\nOne line.\\n' > thin-repo/README.md && python readme_parts.py thin-repo; code=$?; rm -r thin-repo; exit $code",
  "show": "python readme_parts.py thin-repo", "expect_exit": 1,
  "must_contain": ["Team          MISSING"]},
 {"id": "06-deck", "title": "Build the five slides", "kind": "run", "venv": true, "needs_key": ["ANTHROPIC_API_KEY"],
  "cmd": "python build_deck.py sample-repo evidence/03-demo.png deck",
  "show": "python build_deck.py sample-repo evidence/03-demo.png deck",
  "timeout": 120, "must_contain": ["Wrote deck/index.html", "5. Team", "[model call: input tokens"]},
 {"id": "07-view", "title": "Open the deck in a browser", "kind": "web",
  "serve": "python -m http.server 48109 --directory deck", "venv": true,
  "url": "http://127.0.0.1:48109/index.html", "ready_timeout": 30, "size": [1300, 1260],
  "must_contain": ["Action Catcher"]},
 {"id": "08-time", "title": "Time the talk", "kind": "run", "venv": true,
  "cmd": "python timing.py deck/deck.json --limit 180", "must_contain": ["Total", "Fits."]},
 {"id": "09-over", "title": "What a talk that is too long looks like", "kind": "run", "venv": true,
  "cmd": "python timing.py deck/deck.json --limit 60", "expect_exit": 1,
  "must_contain": ["Over by"]}
]
