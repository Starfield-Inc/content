[
 {
  "id": "01-venv",
  "title": "Create a virtual environment",
  "kind": "run",
  "cmd": "python3 -m venv .venv && ls -d .venv",
  "must_contain": [
   ".venv"
  ],
  "show": "python3 -m venv .venv"
 },
 {
  "id": "02-install",
  "title": "Install requests",
  "kind": "run",
  "cmd": "pip install -q -r requirements.txt && pip show requests | sed -n 1,2p",
  "must_contain": [
   "Name: requests"
  ],
  "venv": true,
  "show": "pip install -r requirements.txt",
  "env": {
   "PIP_DISABLE_PIP_VERSION_CHECK": "1"
  },
  "timeout": 300
 },
 {
  "id": "03-fields",
  "title": "Read the licence fields",
  "kind": "run",
  "cmd": "python licence_check.py --tags-only",
  "must_contain": [
   "tag: mit",
   "tag: other",
   "files: ['LICENSE']"
  ],
  "venv": true,
  "timeout": 120
 },
 {
  "id": "04-test",
  "title": "Check the checklist on fixed text",
  "kind": "run",
  "cmd": "python -m unittest discover -s tests -t . -v",
  "must_contain": [
   "OK",
   "test_silence_gives_no_hits"
  ],
  "venv": true
 },
 {
  "id": "05-check",
  "title": "Run the checklist",
  "kind": "run",
  "cmd": "python licence_check.py",
  "must_contain": [
   "Saved report.md",
   "not legal advice"
  ],
  "venv": true,
  "timeout": 180
 },
 {
  "id": "06-mit",
  "title": "Read the report for the MIT model",
  "kind": "run",
  "cmd": "sed -n '/^## deepseek/,/^## mistralai/p' report.md | sed '$d'",
  "must_contain": [
   "Licence tag: `mit`",
   "Silence is not permission"
  ],
  "venv": true
 },
 {
  "id": "07-mistral",
  "title": "Read the report for the Mistral model",
  "kind": "run",
  "cmd": "sed -n '/^## mistralai/,/^## google/p' report.md | sed '$d'",
  "must_contain": [
   "Model as a Service",
   "Licence tag: `other`"
  ],
  "venv": true
 },
 {
  "id": "08-google",
  "title": "Read the report for the Google model",
  "kind": "run",
  "cmd": "sed -n '/^## google/,$p' report.md | head -n 36",
  "must_contain": [
   "non-commercial",
   "timesfm-non-commercial-license-v1.0"
  ],
  "venv": true
 },
 {
  "id": "09-mistake",
  "title": "What a wrong model name looks like",
  "kind": "run",
  "cmd": "python licence_check.py --models mistralai/Mistral-Large-4",
  "must_contain": [
   "not found, or not public"
  ],
  "venv": true,
  "expect_exit": 2,
  "timeout": 60
 }
]