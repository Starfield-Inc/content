[
 {"id": "01-install", "title": "Install the packages", "kind": "run", "timeout": 900,
  "cmd": "npm install --no-audit --no-fund --loglevel=error && npm ls --depth=0 | grep -E '(next|react|react-dom|puppeteer-core|anthropic-ai/sdk)@'",
  "show": "npm install", "env": {"npm_config_update_notifier": "false"},
  "must_contain": ["next@16.4.6", "@anthropic-ai/sdk@1.8.0", "react@19.3.1", "react-dom@19.3.1"]},
 {"id": "02-build", "title": "Build the app", "kind": "run", "timeout": 300,
  "cmd": "npm run build", "show": "npm run build", "env": {"NEXT_TELEMETRY_DISABLED": "1"},
  "must_contain": ["Compiled successfully", "/api/chat"]},
 {"id": "03-no-key", "title": "What a missing key looks like", "kind": "run", "timeout": 120, "expect_exit": 1,
  "cmd": "scripts/with-server.sh node scripts/call-route.mjs", "show": "node scripts/call-route.mjs",
  "env": {"NEXT_TELEMETRY_DISABLED": "1"},
  "must_contain": ["status 500", "ANTHROPIC_API_KEY is not set on the server."]},
 {"id": "04-bad-input", "title": "Reject a body the page would never send", "kind": "run", "timeout": 120,
  "needs_key": ["ANTHROPIC_API_KEY"],
  "cmd": "scripts/with-server.sh node scripts/call-route.mjs --bad", "show": "node scripts/call-route.mjs --bad",
  "env": {"NEXT_TELEMETRY_DISABLED": "1"},
  "must_contain": ["status 400", "Send 1 to 20 messages"]},
 {"id": "05-stream", "title": "Watch the answer arrive in pieces", "kind": "run", "timeout": 120,
  "needs_key": ["ANTHROPIC_API_KEY"],
  "cmd": "scripts/with-server.sh node scripts/call-route.mjs", "show": "node scripts/call-route.mjs",
  "env": {"NEXT_TELEMETRY_DISABLED": "1"},
  "must_contain": ["status 200", "chunk 1 at", "chunks in all", "done:"]},
 {"id": "06-page", "title": "Open the empty page", "kind": "web",
  "serve": "./node_modules/.bin/next start -p 8129", "url": "http://127.0.0.1:8129/",
  "size": [760, 520], "env": {"NEXT_TELEMETRY_DISABLED": "1"},
  "must_contain": ["Streaming chat", "Ask a question to start."]},
 {"id": "07-chat", "title": "Chat with history in Chrome", "kind": "run", "timeout": 240,
  "needs_key": ["ANTHROPIC_API_KEY"],
  "cmd": "scripts/with-server.sh node scripts/drive.mjs chat", "show": "node scripts/drive.mjs chat",
  "env": {"NEXT_TELEMETRY_DISABLED": "1"},
  "must_contain": ["Stop button visible", "messages on page: 4", "saved screenshot history"]},
 {"id": "08-stop", "title": "Press Stop in the middle of an answer", "kind": "run", "timeout": 240,
  "needs_key": ["ANTHROPIC_API_KEY"],
  "cmd": "scripts/with-server.sh node scripts/drive.mjs stop", "show": "node scripts/drive.mjs stop",
  "env": {"NEXT_TELEMETRY_DISABLED": "1"},
  "must_contain": ["no more text arrived", "marked as stopped: true", "client left after", "upstream request aborted"]},
 {"id": "09-error-no-key", "title": "The page when the server has no key", "kind": "run", "timeout": 120,
  "cmd": "scripts/with-server.sh node scripts/drive.mjs error error-no-key", "show": "node scripts/drive.mjs error",
  "env": {"NEXT_TELEMETRY_DISABLED": "1"},
  "must_contain": ["ANTHROPIC_API_KEY is not set on the server.", "Try again button present: true", "you can still type: true"]},
 {"id": "10-error-bad-key", "title": "The page when the API refuses the key", "kind": "run", "timeout": 120,
  "cmd": "scripts/with-server.sh node scripts/drive.mjs error error-bad-key", "show": "ANTHROPIC_API_KEY=not-a-real-key node scripts/drive.mjs error",
  "env": {"NEXT_TELEMETRY_DISABLED": "1", "ANTHROPIC_API_KEY": "not-a-real-key"},
  "must_contain": ["The model call failed (status 401).", "api error: status 401"]},
 {"id": "11-no-leak", "title": "Check that the key is not in the browser files", "kind": "run", "timeout": 60,
  "needs_key": ["ANTHROPIC_API_KEY"],
  "cmd": "node scripts/check-leak.mjs", "show": "node scripts/check-leak.mjs",
  "must_contain": ["files containing the key value: 0", "files containing the name ANTHROPIC_API_KEY: 0"]}
]
